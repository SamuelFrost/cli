{
	"extends": "./.devcontainer.base.json",
	"name": "Overrides",
	"forwardPorts": [443],
	"capAdd": ["NET_ADMIN"],
	"hostRequirements": {
		"memory": "4gb"
	},
	"remoteEnv": {
		"OVERRIDE_ME": "child"
	},
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:1": {
			"version": "latest",
			"moby": true
		}
	}
}
