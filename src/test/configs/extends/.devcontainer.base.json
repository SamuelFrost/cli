{
	"name": "example configuration",
	"image": "mcr.microsoft.com/devcontainers/base:latest",
	"forwardPorts": [80],
	"capAdd": ["SYS_PTRACE"],
	"hostRequirements": {
		"cpus": 2,
		"memory": "8gb"
	},
	"remoteEnv": {
		"FROM_BASE": "base",
		"OVERRIDE_ME": "base"
	},
	"features": {
		"ghcr.io/devcontainers/features/go:1": {
			"version": "latest"
		}
	}
}
